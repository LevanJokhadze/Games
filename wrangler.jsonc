{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site served from Cloudflare Workers (no server code).
  "name": "joker-frontend",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Served on this custom domain (lane.ge zone in the same Cloudflare account).
  "routes": [{ "pattern": "joker.lane.ge", "custom_domain": true }]
}
